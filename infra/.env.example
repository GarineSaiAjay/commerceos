# CommerceOS local environment — copy to infra/.env and fill in.
# NEVER commit infra/.env — secrets must never reach Git history or chat.

# PostgreSQL (defaults match the compose service; host/port are only used
# when connecting from the host machine, not from inside compose).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=commerceos
POSTGRES_USER=commerceos
POSTGRES_PASSWORD=commerceos_dev_password

# Redis (used by the backend for the event bus).
REDIS_HOST=localhost
REDIS_PORT=6379

# Razorpay Test Mode credentials — Razorpay dashboard → Settings → API keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_xxxxxxxxxxxxxxxx

# Razorpay webhook secret — Razorpay dashboard → Settings → Webhooks → your
# webhook → "Secret". Razorpay signs webhook payloads with this, NOT the key
# secret. Leave empty to fall back to RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# LLM provider for the AI Buyer Agent. OpenRouter is OpenAI-compatible, so
# the backend calls it as Chat Completions. Leave OPENROUTER_API_KEY empty to
# fall back to the deterministic extractor.
#   Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Hard daily cap (PLAN-01-AGENTIC-CORE.md §2) on ESTIMATED LLM spend
# across both call sites -- in-memory only, resets on restart. Defaults
# to $5.00/day if unset.
LLM_DAILY_BUDGET_USD=5.0

# Browser origin allowed to call the Commerce Service (CORS). The
# frontend service in docker-compose.yml serves on :3000 by default;
# override this for a public demo URL or a different frontend port.
FRONTEND_ORIGIN=http://localhost:3000
