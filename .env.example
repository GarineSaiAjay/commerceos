# CommerceOS environment configuration
#
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` — the Razorpay Key Secret must never reach
# Git history, logs, frontend code, or the LLM context.

# PostgreSQL connection string (matches docker-compose defaults)
DATABASE_URL=postgres://commerceos:commerceos_dev_password@localhost:5433/commerceos?sslmode=disable

# Razorpay Test Mode credentials
# Get these from the Razorpay dashboard (Settings → API Keys) in Test Mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_xxxxxxxxxxxxxxxx

# Optional: override service ports (defaults shown). Used by docker-compose
# and when running the backend directly.
API_GATEWAY_PORT=8080
COMMERCE_PORT=8081
AGENT_API_PORT=8082
DASHBOARD_PORT=8083
# Redis address (used by the backend for the event bus)
REDIS_ADDR=localhost:6379

# LLM provider for the AI Buyer Agent (Phase 4/5/8) -- an OpenAI-compatible
# Chat Completions API, OpenRouter by default. backend/agents/llm_extractor.go
# reads exactly these three variable names; get an OPENROUTER_API_KEY wrong
# (e.g. call it LLM_API_KEY) and the backend won't error -- it just silently
# falls back to the deterministic keyword extractor (backend/agents/
# deterministic_extractor.go), which only recognizes a handful of literal
# words ("earbud", "laptop", "case", "battery", "noise cancellation") and
# otherwise can't tell products apart. If the shopping-agent proposal looks
# generic or unrelated to what you typed, check this is actually set.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini